{
  "$schema": "https://turbo.build/schema.json",
  "name": "appalter",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/supabase.ts",
    "supabase:migrate": "supabase db push",
    "supabase:reset": "supabase db reset",
    "seed": "tsx scripts/seed-ai.ts",
    "seed:dry": "tsx scripts/seed-ai.ts --dry-run",
    "pipeline:discovery": "tsx scripts/pipeline/01-discovery.ts",
    "pipeline:normalize": "tsx scripts/pipeline/02-normalize.ts",
    "pipeline:enrich": "tsx scripts/pipeline/03-enrich.ts",
    "pipeline:relations": "tsx scripts/pipeline/04-relations.ts",
    "pipeline:validate": "tsx scripts/pipeline/05-validate.ts",
    "pipeline:publish": "tsx scripts/pipeline/06-publish.ts",
    "pipeline:run-all": "npm run pipeline:discovery crm && npm run pipeline:normalize crm && npm run pipeline:enrich crm && npm run pipeline:relations crm && npm run pipeline:validate crm && npm run pipeline:publish crm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@sentry/nextjs": "^8.38.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "next-intl": "^3.26.3",
    "openai": "^7.4.0",
    "posthog-js": "^1.194.0",
    "posthog-node": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "supabase": "^1.214.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie 11"
  ]
}
