NEXT_PUBLIC_SITE_URL=https://appalter.com

# Supabase (anon key — safe for client/edge)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase (service role — SERVER ONLY, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
SENTRY_ORG=your_org
SENTRY_PROJECT=appalter
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

# OpenAI (for embeddings generation — server only)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# Cron job secret (used to authenticate /api/ingest/* routes)
CRON_SECRET=your_random_cron_secret_here

# Revalidation secret (used for on-demand ISR revalidation)
REVALIDATE_SECRET=your_random_revalidation_secret_here

# App Config
NODE_ENV=development
